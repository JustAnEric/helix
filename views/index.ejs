<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Helix</title>
    <link rel="stylesheet" href="/css/app.css">
</head>
<body data-is-helix-app="true" data-is-loading="true">
    <div class="loading-overlay">
        <svg class="torus-loader" width="100" height="100" viewBox="0 0 100 100">
            <path d="M 90 50 A 40 40 0 0 1 10 50 Z" fill="transparent" />
            
            <path fill="#ffffff">
                <animate attributeName="d"
                    values="M 10 50 A 40 40 0 0 1 90 50 Z;
                            M 10 50 A 40 40 0 0 1 90 50 A 8 8 0 0 1 78 50 A 24 24 0 0 0 22 50 A 8 8 0 0 1 10 50 Z;
                            M 10 50 A 40 40 0 0 1 90 50 Z"
                    dur="1.6s"
                    repeatCount="indefinite"
                    calcMode="spline"
                    keyTimes="0; 0.5; 1"
                    keySplines="0.4 0 0.2 1; 0.4 0 0.2 1" />
            </path>
        </svg>

        <span class="loading-message">Loading app...</span>
    </div>

    <main class="app" hidden>
        <aside class="sidebar">
            <div class="in-pad">
                <ul class="menu-buttons top">
                    <li class="menu-button">
                        <img src="/images/icons/message-simple-new.svg" alt="" loading="lazy">
                        New chat
                    </li>
                </ul>
                <div class="menu-header">Chats</div>
                <ul class="menu-buttons">
                    <div class="none-yet">No chats available yet.</div>
                </ul>
            </div>
        </aside>
        <div class="content">
            <div class="chat-header">
                <div class="model-selector" id="modelSelector">
                    <button class="model-trigger" id="modelTrigger">
                        <span class="model-name">helix model</span>
                        <span class="dropdown-arrow">▾</span>
                    </button>
                    <div class="model-dropdown-menu" id="modelMenu"></div>
                </div>

                <div class="chat-title">chat session</div>
            </div>
            <div class="chat-welcome" hidden>
                <h1>How can I help you? ^o^</h1>
            </div>
            <div class="chat-messages">
                <div class="message-wrapper">
                    <div class="ai-header">
                        <div class="icon-wrapper"><div class="icon"></div></div>
                        <div class="author">Helix</div>
                    </div>
                    <div class="message assistant">test assistant message</div>
                </div>
                <div class="message-wrapper user">
                    <div class="message user">test user message</div>
                </div>
            </div>
            <div class="input-area">
                <div class="input-box">
                    <textarea placeholder="message helix..."></textarea>
                    <button class="send-btn">↑</button>
                </div>
                <div class="notice">Only consumer AI models are used - check all responses before commit!</div>
            </div>
        </div>
    </main>

    <script type="module" src="/js/app.js"></script>
</body>
</html>